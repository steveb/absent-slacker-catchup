<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Chat summary for {{ channel }} on {{ date }}</title>
<style>
{{ css | safe }}
</style>
</head>
<body>
<h1>Chat summary for {{ channel }} on {{ date }}</h1>
<p class="meta">
  Window {{ window_start }} &rarr; {{ window_end }}
  &middot; {{ message_count }} message{{ '' if message_count == 1 else 's' }}
  {%- if ignored_message_count %} ({{ ignored_message_count }} ignored){% endif %}
  {%- if nickname_count %}
  from {{ nickname_count }} {{ 'person' if nickname_count == 1 else 'people' }}
  {%- endif %}
  {%- if generated %} &middot; generated {{ generated }}{% endif %}
</p>

{% if errors %}
<div class="notice">
  <strong>This report is incomplete:</strong>
  <ul>
  {%- for error in errors %}
    <li>{{ error }}</li>
  {%- endfor %}
  </ul>
</div>
{% endif %}

{% if message_count and not human_message_count %}
<div class="notice">
  Every message in this window came from an ignored nickname or bot pattern,
  so there is nothing to summarize. They are still listed below.
</div>
{% endif %}

{% if include_audio and audio_href %}
<h2>Audio summary</h2>
<audio src="{{ audio_href }}" controls preload="metadata"></audio>
{% endif %}

{% if include_summary %}
<h2>Summary</h2>
<div class="summary">{{ summary_html | safe }}</div>
{% if thinking %}
<h2>Thinking</h2>
<i>{{ thinking }}</i>
{% endif %}
{% endif %}

{% if include_chat %}
<h2>Chat</h2>
{% if messages %}
<table class="irclog">
{%- for message in messages %}
  <tr id="{{ message.anchor }}"{% if message.ignored %} class="ignored"{% endif %}>
    <th>{{ message.time }}</th>
    <td class="nick">{{ message.nickname }}</td>
    <td class="text">{{ message.text }}</td>
  </tr>
{%- endfor %}
</table>
{% else %}
<p class="meta">No messages in this window.</p>
{% endif %}
{% endif %}
</body>
</html>
